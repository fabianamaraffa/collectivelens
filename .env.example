# Copy to .env and fill in what you need. Nothing here is required: without a key the app still
# searches, groups documents and shows the best matching passages.

# Needed only for written summaries (build) and written answers (Ask the library)
ANTHROPIC_API_KEY=

# Optional settings and their defaults
# COLLECTIVELENS_CLAUDE_MODEL=claude-haiku-5-5
# COLLECTIVELENS_EMBEDDER=auto            # auto, semantic or lite (lite = keyword matching, no download)
# COLLECTIVELENS_EMBEDDING_MODEL=BAAI/bge-m3
# COLLECTIVELENS_DEVICE=cpu               # cpu (safest), mps (Apple chips) or cuda
# COLLECTIVELENS_LIBRARY=                 # folder of the library to open (default: ./library, else the sample)
# COLLECTIVELENS_CATEGORIES=              # your own categories.yaml
# COLLECTIVELENS_DAILY_LIMIT=40           # calls per day made with the server's own key (0 = none)
# COLLECTIVELENS_OPEN_BROWSER=0          # 1 opens the app in your browser when it is ready
# COLLECTIVELENS_SHARE=0                  # 1 makes a temporary public link (be careful)
